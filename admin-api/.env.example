# Database (Supabase Transaction Pooler)
DB_URL=jdbc:postgresql://aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password

# Supabase Storage (cake images)
# Project URL and service role key from Supabase > Project Settings > API.
# Optional: SUPABASE_STORAGE_BUCKET (defaults to cake-images), SUPABASE_PUBLIC_URL for a CDN.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=cake-images

# JWT
JWT_SECRET=your-very-secure-256-bit-secret-key-here

# Server
SERVER_PORT=8080

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Swagger
SWAGGER_UI_ENABLED=true

# Logging
LOG_LEVEL=INFO
